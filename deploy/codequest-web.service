# Frontend Next.js (next start sobre o build de produção). Instalar em
# /etc/systemd/system/ e ativar com systemctl enable --now codequest-web
[Unit]
Description=CodeQuest Web (Next.js)
After=network.target codequest-api.service
Wants=codequest-api.service

[Service]
User=codequest
Group=codequest
WorkingDirectory=/srv/codequest/frontend
Environment=NODE_ENV=production
Environment=API_ORIGIN=http://127.0.0.1:8000
ExecStart=/usr/bin/npm run start -- -H 127.0.0.1 -p 3000
Restart=on-failure

[Install]
WantedBy=multi-user.target
