      <bpmn:outgoing>Flow_RBAC_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_RBAC" name="Administração concluída">
      <bpmn:incoming>Flow_RBAC_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_RBAC_1" sourceRef="Start_RBAC" targetRef="Task_RBAC_Gerir" />
    <bpmn:sequenceFlow id="Flow_RBAC_2" sourceRef="Task_RBAC_Gerir" targetRef="Task_RBAC_Atribuir" />
    <bpmn:sequenceFlow id="Flow_RBAC_3" sourceRef="Task_RBAC_Atribuir" targetRef="Task_RBAC_Auditar" />
    <bpmn:sequenceFlow id="Flow_RBAC_4" sourceRef="Task_RBAC_Auditar" targetRef="Task_RBAC_Consultar" />
    <bpmn:sequenceFlow id="Flow_RBAC_5" sourceRef="Task_RBAC_Consultar" targetRef="End_RBAC" />
  </bpmn:process>

