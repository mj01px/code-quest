<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_CodeQuest_Processos"
  targetNamespace="https://github.com/mj01px/code-quest/bpmn">

  <bpmn:documentation>Modelagem BPMN baseada em fluxos efetivamente implementados no backend Django/DRF, frontend Next.js e integrações (e-mail/Judge0). Fluxos públicos não expõem solucao_autor.</bpmn:documentation>

  <bpmn:collaboration id="Collab_CodeQuest">
    <bpmn:participant id="Part_Aluno" name="Aluno/Usuário" processRef="Proc_Aluno" />
    <bpmn:participant id="Part_AutorAdmin" name="Autor/Revisor/Admin" processRef="Proc_AutorAdmin" />
    <bpmn:participant id="Part_Frontend" name="Frontend Next.js" processRef="Proc_Frontend" />
    <bpmn:participant id="Part_API" name="API Django/DRF" processRef="Proc_API_Orquestracao" />
    <bpmn:participant id="Part_DB" name="Banco PostgreSQL" processRef="Proc_DB" />
    <bpmn:participant id="Part_Email" name="Serviço de E-mail" processRef="Proc_Email" />
    <bpmn:participant id="Part_Judge0" name="Judge0" processRef="Proc_Judge0" />

    <bpmn:messageFlow id="MF_FE_API" sourceRef="Task_FE_Enviar" targetRef="Task_API_Receber" name="Requisição /api/v1/" />
    <bpmn:messageFlow id="MF_API_FE" sourceRef="Task_API_Responder" targetRef="Task_FE_Renderizar" name="Resposta JSON (sucesso/erro)" />
    <bpmn:messageFlow id="MF_API_DB" sourceRef="Task_API_Persistir" targetRef="Task_DB_Persistir" name="CRUD transacional" />
    <bpmn:messageFlow id="MF_DB_API" sourceRef="Task_DB_Persistir" targetRef="Task_API_Responder" name="Dados persistidos/consultados" />
    <bpmn:messageFlow id="MF_API_EMAIL" sourceRef="Task_API_Email" targetRef="Task_Email_Enviar" name="Verificação, MFA, recuperação, exclusão" />
    <bpmn:messageFlow id="MF_EMAIL_API" sourceRef="Task_Email_Enviar" targetRef="Task_API_Responder" name="Status de envio" />
    <bpmn:messageFlow id="MF_API_JUDGE" sourceRef="Task_API_Judge0" targetRef="Task_Judge_Executar" name="Submissão de código" />
    <bpmn:messageFlow id="MF_JUDGE_API" sourceRef="Task_Judge_Executar" targetRef="Task_API_Responder" name="Resultado de execução" />
    <bpmn:textAnnotation id="TA_Collab_1">
      <bpmn:text>Colaboração macro: frontend orquestra chamadas para a API; regras e exceções são detalhadas nos processos lógicos abaixo.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Collab_1" sourceRef="Task_API_Receber" targetRef="TA_Collab_1" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_Aluno" name="Interação do Aluno" isExecutable="false">
    <bpmn:startEvent id="Start_Aluno" name="Acessa plataforma">
      <bpmn:outgoing>Flow_Aluno_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Aluno_Usar" name="Cadastrar, estudar, concluir exercícios e gerir conta">
      <bpmn:incoming>Flow_Aluno_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Aluno_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Aluno" name="Sessão concluída">
      <bpmn:incoming>Flow_Aluno_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Aluno_1" sourceRef="Start_Aluno" targetRef="Task_Aluno_Usar" />
    <bpmn:sequenceFlow id="Flow_Aluno_2" sourceRef="Task_Aluno_Usar" targetRef="End_Aluno" />
  </bpmn:process>

  <bpmn:process id="Proc_AutorAdmin" name="Interação Autor/Revisor/Admin" isExecutable="false">
    <bpmn:startEvent id="Start_Autor" name="Demanda editorial ou administrativa">
      <bpmn:outgoing>Flow_Autor_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Autor_Operar" name="Criar/revisar conteúdo, administrar RBAC e auditoria">
      <bpmn:incoming>Flow_Autor_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Autor_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Autor" name="Ação finalizada">
      <bpmn:incoming>Flow_Autor_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Autor_1" sourceRef="Start_Autor" targetRef="Task_Autor_Operar" />
    <bpmn:sequenceFlow id="Flow_Autor_2" sourceRef="Task_Autor_Operar" targetRef="End_Autor" />
  </bpmn:process>

  <bpmn:process id="Proc_Frontend" name="Frontend Next.js" isExecutable="false">
    <bpmn:startEvent id="Start_FE" name="Ação de UI">
      <bpmn:outgoing>Flow_FE_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_FE_Enviar" name="Enviar requisição HTTP para API">
      <bpmn:incoming>Flow_FE_1</bpmn:incoming>
      <bpmn:outgoing>Flow_FE_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_FE_Renderizar" name="Renderizar retorno e exceções">
      <bpmn:incoming>Flow_FE_2</bpmn:incoming>
      <bpmn:outgoing>Flow_FE_3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="End_FE" name="Tela atualizada">
      <bpmn:incoming>Flow_FE_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_FE_1" sourceRef="Start_FE" targetRef="Task_FE_Enviar" />
    <bpmn:sequenceFlow id="Flow_FE_2" sourceRef="Task_FE_Enviar" targetRef="Task_FE_Renderizar" />
    <bpmn:sequenceFlow id="Flow_FE_3" sourceRef="Task_FE_Renderizar" targetRef="End_FE" />
  </bpmn:process>

  <bpmn:process id="Proc_API_Orquestracao" name="API Django/DRF (orquestração macro)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_API">
      <bpmn:lane id="Lane_API_Entrada" name="Entrada e resposta">
        <bpmn:flowNodeRef>Start_API</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_API_Receber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_API_Dominio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_API_Responder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_API_Regras" name="Processos lógicos">
        <bpmn:flowNodeRef>Call_Cadastro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_Editorial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_Jornada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_Correcao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_Criaturas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_LGPD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_RBAC</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_API_Integracoes" name="Persistência e integrações">
        <bpmn:flowNodeRef>Task_API_Persistir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_API_Email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_API_Judge0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_API</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_API" name="Recebe chamada REST">
      <bpmn:outgoing>Flow_API_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_API_Receber" name="Autenticar, autorizar e rotear endpoint">
      <bpmn:incoming>Flow_API_1</bpmn:incoming>
      <bpmn:outgoing>Flow_API_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_API_Dominio" name="Domínio da requisição">
      <bpmn:incoming>Flow_API_2</bpmn:incoming>
      <bpmn:outgoing>Flow_API_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_API_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_API_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_API_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_API_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_API_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_API_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:callActivity id="Call_Cadastro" name="Cadastro, verificação, login e MFA" calledElement="Proc_Detalhe_CadastroLogin">
      <bpmn:incoming>Flow_API_3</bpmn:incoming>
      <bpmn:outgoing>Flow_API_10</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Editorial" name="Fluxo editorial (trilhas/aulas/exercícios)" calledElement="Proc_Detalhe_Editorial">
      <bpmn:incoming>Flow_API_4</bpmn:incoming>
      <bpmn:outgoing>Flow_API_10a</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Jornada" name="Jornada de aprendizagem e XP" calledElement="Proc_Detalhe_Jornada">
      <bpmn:incoming>Flow_API_5</bpmn:incoming>
      <bpmn:outgoing>Flow_API_10b</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Correcao" name="Correção automática com Judge0" calledElement="Proc_Detalhe_Correcao">
      <bpmn:incoming>Flow_API_6</bpmn:incoming>
      <bpmn:outgoing>Flow_API_10c</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Criaturas" name="Gestão de criaturas" calledElement="Proc_Detalhe_Criaturas">
      <bpmn:incoming>Flow_API_7</bpmn:incoming>
      <bpmn:outgoing>Flow_API_10d</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_LGPD" name="Direitos LGPD" calledElement="Proc_Detalhe_LGPD">
      <bpmn:incoming>Flow_API_8</bpmn:incoming>
      <bpmn:outgoing>Flow_API_10e</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_RBAC" name="Administração RBAC e auditoria" calledElement="Proc_Detalhe_RBACAuditoria">
      <bpmn:incoming>Flow_API_9</bpmn:incoming>
      <bpmn:outgoing>Flow_API_10f</bpmn:outgoing>
    </bpmn:callActivity>

    <bpmn:parallelGateway id="Gateway_API_Join" name="Consolidar resposta">
      <bpmn:incoming>Flow_API_10</bpmn:incoming>
      <bpmn:incoming>Flow_API_10a</bpmn:incoming>
      <bpmn:incoming>Flow_API_10b</bpmn:incoming>
      <bpmn:incoming>Flow_API_10c</bpmn:incoming>
      <bpmn:incoming>Flow_API_10d</bpmn:incoming>
      <bpmn:incoming>Flow_API_10e</bpmn:incoming>
      <bpmn:incoming>Flow_API_10f</bpmn:incoming>
      <bpmn:outgoing>Flow_API_11</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_API_Persistir" name="Persistir/consultar estado no PostgreSQL">
      <bpmn:incoming>Flow_API_11</bpmn:incoming>
      <bpmn:outgoing>Flow_API_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_API_Email" name="Disparar e-mails quando aplicável">
      <bpmn:incoming>Flow_API_12</bpmn:incoming>
      <bpmn:outgoing>Flow_API_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_API_Judge0" name="Acionar Judge0 quando aplicável">
      <bpmn:incoming>Flow_API_13</bpmn:incoming>
      <bpmn:outgoing>Flow_API_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_API_Responder" name="Montar envelope de resposta e retornar">
      <bpmn:incoming>Flow_API_14</bpmn:incoming>
      <bpmn:outgoing>Flow_API_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_API" name="Resposta enviada">
      <bpmn:incoming>Flow_API_15</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_API_1" sourceRef="Start_API" targetRef="Task_API_Receber" />
    <bpmn:sequenceFlow id="Flow_API_2" sourceRef="Task_API_Receber" targetRef="Gateway_API_Dominio" />
    <bpmn:sequenceFlow id="Flow_API_3" sourceRef="Gateway_API_Dominio" targetRef="Call_Cadastro" />
    <bpmn:sequenceFlow id="Flow_API_4" sourceRef="Gateway_API_Dominio" targetRef="Call_Editorial" />
    <bpmn:sequenceFlow id="Flow_API_5" sourceRef="Gateway_API_Dominio" targetRef="Call_Jornada" />
    <bpmn:sequenceFlow id="Flow_API_6" sourceRef="Gateway_API_Dominio" targetRef="Call_Correcao" />
    <bpmn:sequenceFlow id="Flow_API_7" sourceRef="Gateway_API_Dominio" targetRef="Call_Criaturas" />
    <bpmn:sequenceFlow id="Flow_API_8" sourceRef="Gateway_API_Dominio" targetRef="Call_LGPD" />
    <bpmn:sequenceFlow id="Flow_API_9" sourceRef="Gateway_API_Dominio" targetRef="Call_RBAC" />
    <bpmn:sequenceFlow id="Flow_API_10" sourceRef="Call_Cadastro" targetRef="Gateway_API_Join" />
    <bpmn:sequenceFlow id="Flow_API_10a" sourceRef="Call_Editorial" targetRef="Gateway_API_Join" />
    <bpmn:sequenceFlow id="Flow_API_10b" sourceRef="Call_Jornada" targetRef="Gateway_API_Join" />
    <bpmn:sequenceFlow id="Flow_API_10c" sourceRef="Call_Correcao" targetRef="Gateway_API_Join" />
    <bpmn:sequenceFlow id="Flow_API_10d" sourceRef="Call_Criaturas" targetRef="Gateway_API_Join" />
    <bpmn:sequenceFlow id="Flow_API_10e" sourceRef="Call_LGPD" targetRef="Gateway_API_Join" />
    <bpmn:sequenceFlow id="Flow_API_10f" sourceRef="Call_RBAC" targetRef="Gateway_API_Join" />
    <bpmn:sequenceFlow id="Flow_API_11" sourceRef="Gateway_API_Join" targetRef="Task_API_Persistir" />
    <bpmn:sequenceFlow id="Flow_API_12" sourceRef="Task_API_Persistir" targetRef="Task_API_Email" />
    <bpmn:sequenceFlow id="Flow_API_13" sourceRef="Task_API_Email" targetRef="Task_API_Judge0" />
    <bpmn:sequenceFlow id="Flow_API_14" sourceRef="Task_API_Judge0" targetRef="Task_API_Responder" />
    <bpmn:sequenceFlow id="Flow_API_15" sourceRef="Task_API_Responder" targetRef="End_API" />
  </bpmn:process>

  <bpmn:process id="Proc_DB" name="Banco PostgreSQL" isExecutable="false">
    <bpmn:startEvent id="Start_DB" name="Solicitação de persistência">
      <bpmn:outgoing>Flow_DB_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_DB_Persistir" name="Ler/escrever dados transacionais">
      <bpmn:incoming>Flow_DB_1</bpmn:incoming>
      <bpmn:outgoing>Flow_DB_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_DB" name="Operação concluída">
      <bpmn:incoming>Flow_DB_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_DB_1" sourceRef="Start_DB" targetRef="Task_DB_Persistir" />
    <bpmn:sequenceFlow id="Flow_DB_2" sourceRef="Task_DB_Persistir" targetRef="End_DB" />
  </bpmn:process>

  <bpmn:process id="Proc_Email" name="Serviço de E-mail" isExecutable="false">
    <bpmn:startEvent id="Start_Email" name="Mensagem recebida">
      <bpmn:outgoing>Flow_Email_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Email_Enviar" name="Enviar e-mail transacional">
      <bpmn:incoming>Flow_Email_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Email_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Email" name="Status de envio">
      <bpmn:incoming>Flow_Email_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Email_1" sourceRef="Start_Email" targetRef="Task_Email_Enviar" />
    <bpmn:sequenceFlow id="Flow_Email_2" sourceRef="Task_Email_Enviar" targetRef="End_Email" />
  </bpmn:process>

  <bpmn:process id="Proc_Judge0" name="Judge0" isExecutable="false">
    <bpmn:startEvent id="Start_Judge" name="Submissão recebida">
      <bpmn:outgoing>Flow_Judge_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Judge_Executar" name="Executar harness e testes">
      <bpmn:incoming>Flow_Judge_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Judge_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Judge" name="Resultado disponível">
      <bpmn:incoming>Flow_Judge_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Judge_1" sourceRef="Start_Judge" targetRef="Task_Judge_Executar" />
    <bpmn:sequenceFlow id="Flow_Judge_2" sourceRef="Task_Judge_Executar" targetRef="End_Judge" />
  </bpmn:process>

  <bpmn:process id="Proc_Detalhe_CadastroLogin" name="Detalhe: Cadastro, verificação e login/MFA" isExecutable="false">
    <bpmn:startEvent id="Start_Cad" name="Cadastro solicitado">
      <bpmn:outgoing>Flow_Cad_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Cad_Validar" name="Validar idade mínima (16+) e aceite legal">
      <bpmn:incoming>Flow_Cad_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Cad_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Cad_EmailExiste" name="E-mail já cadastrado?">
      <bpmn:incoming>Flow_Cad_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Cad_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cad_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Cad_AvisoTentativa" name="Avisar tentativa de cadastro por e-mail">
      <bpmn:incoming>Flow_Cad_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Cad_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Cad_EmailExiste" name="Cadastro não criado (e-mail existente)">
      <bpmn:incoming>Flow_Cad_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_Cad_CriarConta" name="Criar conta pendente e enviar verificação">
      <bpmn:incoming>Flow_Cad_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Cad_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Evt_Cad_AguardarClique" name="Aguardar link de verificação">
      <bpmn:incoming>Flow_Cad_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Cad_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_Cad_Verificacao" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_Cad_TokenVerifValido" name="Token de verificação válido?">
      <bpmn:incoming>Flow_Cad_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Cad_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cad_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Cad_Reenviar" name="Reenviar verificação">
      <bpmn:incoming>Flow_Cad_9</bpmn:incoming>
      <bpmn:outgoing>Flow_Cad_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Evt_Cad_TimerReenvio" name="Verificação expirada / reenvio">
      <bpmn:incoming>Flow_Cad_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Cad_6a</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Cad_Reenvio" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_Login" name="Login com e-mail e senha">
      <bpmn:incoming>Flow_Cad_8</bpmn:incoming>
      <bpmn:incoming>Flow_Cad_6a</bpmn:incoming>
      <bpmn:outgoing>Flow_Cad_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Login_Bloqueado" name="Conta bloqueada por tentativas?">
      <bpmn:incoming>Flow_Cad_11</bpmn:incoming>
      <bpmn:outgoing>Flow_Cad_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cad_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Login_Bloqueado" name="Falha: bloqueio temporário">
      <bpmn:incoming>Flow_Cad_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Login_MFAAtivo" name="MFA ativo?">
      <bpmn:incoming>Flow_Cad_13</bpmn:incoming>
      <bpmn:outgoing>Flow_Cad_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cad_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Login_EmitirJWT" name="Emitir JWT em cookies HttpOnly">
      <bpmn:incoming>Flow_Cad_14</bpmn:incoming>
      <bpmn:incoming>Flow_Cad_18</bpmn:incoming>
      <bpmn:outgoing>Flow_Cad_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Login_OK" name="Sessão autenticada">
      <bpmn:incoming>Flow_Cad_19</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_Login_DesafioMFA" name="Gerar desafio MFA (TOTP/e-mail)">
      <bpmn:incoming>Flow_Cad_15</bpmn:incoming>
      <bpmn:outgoing>Flow_Cad_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Login_ValidarMFA" name="Validar código MFA/recuperação">
      <bpmn:incoming>Flow_Cad_16</bpmn:incoming>
      <bpmn:outgoing>Flow_Cad_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Login_MFAValido" name="Código MFA válido?">
      <bpmn:incoming>Flow_Cad_17</bpmn:incoming>
      <bpmn:outgoing>Flow_Cad_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cad_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Login_MFAInvalido" name="Falha: MFA inválido/expirado">
      <bpmn:incoming>Flow_Cad_20</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Cad_1" sourceRef="Start_Cad" targetRef="Task_Cad_Validar" />
    <bpmn:sequenceFlow id="Flow_Cad_2" sourceRef="Task_Cad_Validar" targetRef="Gw_Cad_EmailExiste" />
    <bpmn:sequenceFlow id="Flow_Cad_3" sourceRef="Gw_Cad_EmailExiste" targetRef="Task_Cad_AvisoTentativa" name="Sim" />
    <bpmn:sequenceFlow id="Flow_Cad_4" sourceRef="Gw_Cad_EmailExiste" targetRef="Task_Cad_CriarConta" name="Não" />
    <bpmn:sequenceFlow id="Flow_Cad_5" sourceRef="Task_Cad_AvisoTentativa" targetRef="End_Cad_EmailExiste" />
    <bpmn:sequenceFlow id="Flow_Cad_6" sourceRef="Task_Cad_CriarConta" targetRef="Evt_Cad_AguardarClique" />
    <bpmn:sequenceFlow id="Flow_Cad_7" sourceRef="Evt_Cad_AguardarClique" targetRef="Gw_Cad_TokenVerifValido" />
    <bpmn:sequenceFlow id="Flow_Cad_8" sourceRef="Gw_Cad_TokenVerifValido" targetRef="Task_Login" name="Válido" />
    <bpmn:sequenceFlow id="Flow_Cad_9" sourceRef="Gw_Cad_TokenVerifValido" targetRef="Task_Cad_Reenviar" name="Expirado/Inválido" />
    <bpmn:sequenceFlow id="Flow_Cad_10" sourceRef="Task_Cad_Reenviar" targetRef="Evt_Cad_TimerReenvio" />
    <bpmn:sequenceFlow id="Flow_Cad_6a" sourceRef="Evt_Cad_TimerReenvio" targetRef="Task_Login" />
    <bpmn:sequenceFlow id="Flow_Cad_11" sourceRef="Task_Login" targetRef="Gw_Login_Bloqueado" />
    <bpmn:sequenceFlow id="Flow_Cad_12" sourceRef="Gw_Login_Bloqueado" targetRef="End_Login_Bloqueado" name="Sim" />
    <bpmn:sequenceFlow id="Flow_Cad_13" sourceRef="Gw_Login_Bloqueado" targetRef="Gw_Login_MFAAtivo" name="Não" />
    <bpmn:sequenceFlow id="Flow_Cad_14" sourceRef="Gw_Login_MFAAtivo" targetRef="Task_Login_EmitirJWT" name="Não" />
    <bpmn:sequenceFlow id="Flow_Cad_15" sourceRef="Gw_Login_MFAAtivo" targetRef="Task_Login_DesafioMFA" name="Sim" />
    <bpmn:sequenceFlow id="Flow_Cad_16" sourceRef="Task_Login_DesafioMFA" targetRef="Task_Login_ValidarMFA" />
    <bpmn:sequenceFlow id="Flow_Cad_17" sourceRef="Task_Login_ValidarMFA" targetRef="Gw_Login_MFAValido" />
    <bpmn:sequenceFlow id="Flow_Cad_18" sourceRef="Gw_Login_MFAValido" targetRef="Task_Login_EmitirJWT" name="Sim" />
    <bpmn:sequenceFlow id="Flow_Cad_19" sourceRef="Task_Login_EmitirJWT" targetRef="End_Login_OK" />
    <bpmn:sequenceFlow id="Flow_Cad_20" sourceRef="Gw_Login_MFAValido" targetRef="End_Login_MFAInvalido" name="Não" />
  </bpmn:process>

  <bpmn:process id="Proc_Detalhe_Editorial" name="Detalhe: Fluxo editorial e publicação" isExecutable="false">
    <bpmn:startEvent id="Start_Edit" name="Criar/editar conteúdo">
      <bpmn:outgoing>Flow_Edit_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Edit_Rascunho" name="Salvar rascunho (trilha/aula/exercício)">
      <bpmn:incoming>Flow_Edit_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Edit_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Edit_EnviarRev" name="Enviar para revisão">
      <bpmn:incoming>Flow_Edit_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Edit_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Edit_Revisar" name="Revisor avalia conteúdo e solução do autor (rota restrita)">
      <bpmn:incoming>Flow_Edit_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Edit_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Edit_Aprovado" name="Aprovado?">
      <bpmn:incoming>Flow_Edit_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Edit_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_Edit_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Edit_Devolver" name="Devolver para ajustes">
      <bpmn:incoming>Flow_Edit_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Edit_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Edit_Devolvido" name="Conteúdo devolvido">
      <bpmn:incoming>Flow_Edit_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Edit_Publicar" name="Aprovar e publicar">
      <bpmn:incoming>Flow_Edit_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Edit_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Edit_Catalogo" name="Expor somente itens PUBLICADOS no catálogo">
      <bpmn:incoming>Flow_Edit_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Edit_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Edit_Publicado" name="Conteúdo visível publicamente">
      <bpmn:incoming>Flow_Edit_9</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Edit_1" sourceRef="Start_Edit" targetRef="Task_Edit_Rascunho" />
    <bpmn:sequenceFlow id="Flow_Edit_2" sourceRef="Task_Edit_Rascunho" targetRef="Task_Edit_EnviarRev" />
    <bpmn:sequenceFlow id="Flow_Edit_3" sourceRef="Task_Edit_EnviarRev" targetRef="Task_Edit_Revisar" />
    <bpmn:sequenceFlow id="Flow_Edit_4" sourceRef="Task_Edit_Revisar" targetRef="Gw_Edit_Aprovado" />
    <bpmn:sequenceFlow id="Flow_Edit_5" sourceRef="Gw_Edit_Aprovado" targetRef="Task_Edit_Devolver" name="Não" />
    <bpmn:sequenceFlow id="Flow_Edit_6" sourceRef="Gw_Edit_Aprovado" targetRef="Task_Edit_Publicar" name="Sim" />
    <bpmn:sequenceFlow id="Flow_Edit_7" sourceRef="Task_Edit_Devolver" targetRef="End_Edit_Devolvido" />
    <bpmn:sequenceFlow id="Flow_Edit_8" sourceRef="Task_Edit_Publicar" targetRef="Task_Edit_Catalogo" />
    <bpmn:sequenceFlow id="Flow_Edit_9" sourceRef="Task_Edit_Catalogo" targetRef="End_Edit_Publicado" />
  </bpmn:process>

  <bpmn:process id="Proc_Detalhe_Jornada" name="Detalhe: Jornada de aprendizagem e crédito de XP" isExecutable="false">
    <bpmn:startEvent id="Start_Jor" name="Usuário navega no catálogo">
      <bpmn:outgoing>Flow_Jor_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Jor_Consultar" name="Consultar catálogo público (somente publicados)">
      <bpmn:incoming>Flow_Jor_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Jor_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Jor_Iniciar" name="Iniciar trilha (idempotente)">
      <bpmn:incoming>Flow_Jor_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Jor_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Jor_Abrir" name="Abrir aula/exercício">
      <bpmn:incoming>Flow_Jor_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Jor_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Jor_TipoEx" name="Exercício de código?">
      <bpmn:incoming>Flow_Jor_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Jor_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_Jor_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Jor_Executar" name="Executar código (sem XP)">
      <bpmn:incoming>Flow_Jor_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Jor_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Jor_Enviar" name="Enviar código para correção">
      <bpmn:incoming>Flow_Jor_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Jor_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Jor_Aprovado" name="Envio aprovado?">
      <bpmn:incoming>Flow_Jor_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Jor_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_Jor_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Jor_Reprovado" name="Reprovado: não credita XP">
      <bpmn:incoming>Flow_Jor_9</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_Jor_ConcluirTeorico" name="Concluir exercício teórico">
      <bpmn:incoming>Flow_Jor_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Jor_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Jor_ConcluirCodigo" name="Concluir exercício de código aprovado">
      <bpmn:incoming>Flow_Jor_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Jor_11a</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Jor_PreCond" name="Exercício publicado + conta ativa + criatura ativa?">
      <bpmn:incoming>Flow_Jor_11</bpmn:incoming>
      <bpmn:incoming>Flow_Jor_11a</bpmn:incoming>
      <bpmn:outgoing>Flow_Jor_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_Jor_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Jor_PreCondErro" name="Falha: sem criatura ativa/conta inativa/não publicado">
      <bpmn:incoming>Flow_Jor_13</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_Jor_Creditar" name="Creditar XP (50/100/200 * multiplicador)">
      <bpmn:incoming>Flow_Jor_12</bpmn:incoming>
      <bpmn:outgoing>Flow_Jor_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Jor_JaConcluido" name="EventoXP já existe para usuário/exercício?">
      <bpmn:incoming>Flow_Jor_14</bpmn:incoming>
      <bpmn:outgoing>Flow_Jor_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_Jor_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Jor_SemDuplicar" name="Já concluído: sem duplicar XP">
      <bpmn:incoming>Flow_Jor_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Jor_Sinalizar" name="Atualizar progresso e sinalizar pode_evoluir">
      <bpmn:incoming>Flow_Jor_16</bpmn:incoming>
      <bpmn:outgoing>Flow_Jor_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Jor_XP" name="XP creditado (sem evolução automática)">
      <bpmn:incoming>Flow_Jor_17</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Jor_1" sourceRef="Start_Jor" targetRef="Task_Jor_Consultar" />
    <bpmn:sequenceFlow id="Flow_Jor_2" sourceRef="Task_Jor_Consultar" targetRef="Task_Jor_Iniciar" />
    <bpmn:sequenceFlow id="Flow_Jor_3" sourceRef="Task_Jor_Iniciar" targetRef="Task_Jor_Abrir" />
    <bpmn:sequenceFlow id="Flow_Jor_4" sourceRef="Task_Jor_Abrir" targetRef="Gw_Jor_TipoEx" />
    <bpmn:sequenceFlow id="Flow_Jor_5" sourceRef="Gw_Jor_TipoEx" targetRef="Task_Jor_Executar" name="Sim" />
    <bpmn:sequenceFlow id="Flow_Jor_6" sourceRef="Gw_Jor_TipoEx" targetRef="Task_Jor_ConcluirTeorico" name="Não" />
    <bpmn:sequenceFlow id="Flow_Jor_7" sourceRef="Task_Jor_Executar" targetRef="Task_Jor_Enviar" />
    <bpmn:sequenceFlow id="Flow_Jor_8" sourceRef="Task_Jor_Enviar" targetRef="Gw_Jor_Aprovado" />
    <bpmn:sequenceFlow id="Flow_Jor_9" sourceRef="Gw_Jor_Aprovado" targetRef="End_Jor_Reprovado" name="Não" />
    <bpmn:sequenceFlow id="Flow_Jor_10" sourceRef="Gw_Jor_Aprovado" targetRef="Task_Jor_ConcluirCodigo" name="Sim" />
    <bpmn:sequenceFlow id="Flow_Jor_11" sourceRef="Task_Jor_ConcluirTeorico" targetRef="Gw_Jor_PreCond" />
    <bpmn:sequenceFlow id="Flow_Jor_11a" sourceRef="Task_Jor_ConcluirCodigo" targetRef="Gw_Jor_PreCond" />
    <bpmn:sequenceFlow id="Flow_Jor_12" sourceRef="Gw_Jor_PreCond" targetRef="Task_Jor_Creditar" name="Sim" />
    <bpmn:sequenceFlow id="Flow_Jor_13" sourceRef="Gw_Jor_PreCond" targetRef="End_Jor_PreCondErro" name="Não" />
    <bpmn:sequenceFlow id="Flow_Jor_14" sourceRef="Task_Jor_Creditar" targetRef="Gw_Jor_JaConcluido" />
    <bpmn:sequenceFlow id="Flow_Jor_15" sourceRef="Gw_Jor_JaConcluido" targetRef="End_Jor_SemDuplicar" name="Sim" />
    <bpmn:sequenceFlow id="Flow_Jor_16" sourceRef="Gw_Jor_JaConcluido" targetRef="Task_Jor_Sinalizar" name="Não" />
    <bpmn:sequenceFlow id="Flow_Jor_17" sourceRef="Task_Jor_Sinalizar" targetRef="End_Jor_XP" />
  </bpmn:process>

  <bpmn:process id="Proc_Detalhe_Correcao" name="Detalhe: Correção automática com AST, cache, cotas e Judge0" isExecutable="false">
    <bpmn:startEvent id="Start_Cor" name="Executar/Enviar código">
      <bpmn:outgoing>Flow_Cor_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Cor_Validar" name="Validar conta, exercício, especificação e código">
      <bpmn:incoming>Flow_Cor_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Cor_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Cor_AST" name="Análise AST (sintaxe, função, exigências/proibições)">
      <bpmn:incoming>Flow_Cor_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Cor_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Cor_ASTValida" name="AST válida?">
      <bpmn:incoming>Flow_Cor_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Cor_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cor_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cor_ASTInvalida" name="Falha: AST inválida">
      <bpmn:incoming>Flow_Cor_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Cor_Cache" name="Submissão idêntica em cache (&lt;10 min)?">
      <bpmn:incoming>Flow_Cor_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Cor_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cor_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cor_Cache" name="Retorna resultado em cache">
      <bpmn:incoming>Flow_Cor_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Cor_Cota" name="Verificar cota por usuário/global">
      <bpmn:incoming>Flow_Cor_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Cor_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Cor_CotaOK" name="Cota disponível?">
      <bpmn:incoming>Flow_Cor_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Cor_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cor_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cor_Cota" name="Falha: cota esgotada (429/503)">
      <bpmn:incoming>Flow_Cor_10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_Cor_Judge" name="Enviar para Judge0">
      <bpmn:incoming>Flow_Cor_9</bpmn:incoming>
      <bpmn:outgoing>Flow_Cor_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Cor_JudgeDisponivel" name="Judge0 disponível?">
      <bpmn:incoming>Flow_Cor_11</bpmn:incoming>
      <bpmn:outgoing>Flow_Cor_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cor_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cor_Indisp" name="Falha: corretor indisponível">
      <bpmn:incoming>Flow_Cor_13</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gw_Cor_Modo" name="Modo EXECUTAR ou ENVIAR?">
      <bpmn:incoming>Flow_Cor_12</bpmn:incoming>
      <bpmn:outgoing>Flow_Cor_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cor_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Cor_ExecutarVisiveis" name="EXECUTAR: rodar só casos visíveis">
      <bpmn:incoming>Flow_Cor_14</bpmn:incoming>
      <bpmn:outgoing>Flow_Cor_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Cor_Executar" name="Retorno de depuração (sem XP)">
      <bpmn:incoming>Flow_Cor_16</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_Cor_EnviarTodos" name="ENVIAR: rodar todos casos (ocultos sem detalhes)">
      <bpmn:incoming>Flow_Cor_15</bpmn:incoming>
      <bpmn:outgoing>Flow_Cor_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Cor_Aprovado" name="Todos os casos passaram?">
      <bpmn:incoming>Flow_Cor_17</bpmn:incoming>
      <bpmn:outgoing>Flow_Cor_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cor_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cor_Reprovado" name="Envio reprovado (não conclui)">
      <bpmn:incoming>Flow_Cor_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Cor_Aprovado" name="Envio aprovado para conclusão">
      <bpmn:incoming>Flow_Cor_19</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Cor_1" sourceRef="Start_Cor" targetRef="Task_Cor_Validar" />
    <bpmn:sequenceFlow id="Flow_Cor_2" sourceRef="Task_Cor_Validar" targetRef="Task_Cor_AST" />
    <bpmn:sequenceFlow id="Flow_Cor_3" sourceRef="Task_Cor_AST" targetRef="Gw_Cor_ASTValida" />
    <bpmn:sequenceFlow id="Flow_Cor_4" sourceRef="Gw_Cor_ASTValida" targetRef="Gw_Cor_Cache" name="Sim" />
    <bpmn:sequenceFlow id="Flow_Cor_5" sourceRef="Gw_Cor_ASTValida" targetRef="End_Cor_ASTInvalida" name="Não" />
    <bpmn:sequenceFlow id="Flow_Cor_6" sourceRef="Gw_Cor_Cache" targetRef="End_Cor_Cache" name="Sim" />
    <bpmn:sequenceFlow id="Flow_Cor_7" sourceRef="Gw_Cor_Cache" targetRef="Task_Cor_Cota" name="Não" />
    <bpmn:sequenceFlow id="Flow_Cor_8" sourceRef="Task_Cor_Cota" targetRef="Gw_Cor_CotaOK" />
    <bpmn:sequenceFlow id="Flow_Cor_9" sourceRef="Gw_Cor_CotaOK" targetRef="Task_Cor_Judge" name="Sim" />
    <bpmn:sequenceFlow id="Flow_Cor_10" sourceRef="Gw_Cor_CotaOK" targetRef="End_Cor_Cota" name="Não" />
    <bpmn:sequenceFlow id="Flow_Cor_11" sourceRef="Task_Cor_Judge" targetRef="Gw_Cor_JudgeDisponivel" />
    <bpmn:sequenceFlow id="Flow_Cor_12" sourceRef="Gw_Cor_JudgeDisponivel" targetRef="Gw_Cor_Modo" name="Sim" />
    <bpmn:sequenceFlow id="Flow_Cor_13" sourceRef="Gw_Cor_JudgeDisponivel" targetRef="End_Cor_Indisp" name="Não" />
    <bpmn:sequenceFlow id="Flow_Cor_14" sourceRef="Gw_Cor_Modo" targetRef="Task_Cor_ExecutarVisiveis" name="EXECUTAR" />
    <bpmn:sequenceFlow id="Flow_Cor_15" sourceRef="Gw_Cor_Modo" targetRef="Task_Cor_EnviarTodos" name="ENVIAR" />
    <bpmn:sequenceFlow id="Flow_Cor_16" sourceRef="Task_Cor_ExecutarVisiveis" targetRef="End_Cor_Executar" />
    <bpmn:sequenceFlow id="Flow_Cor_17" sourceRef="Task_Cor_EnviarTodos" targetRef="Gw_Cor_Aprovado" />
    <bpmn:sequenceFlow id="Flow_Cor_18" sourceRef="Gw_Cor_Aprovado" targetRef="End_Cor_Reprovado" name="Não" />
    <bpmn:sequenceFlow id="Flow_Cor_19" sourceRef="Gw_Cor_Aprovado" targetRef="End_Cor_Aprovado" name="Sim" />
  </bpmn:process>

  <bpmn:process id="Proc_Detalhe_Criaturas" name="Detalhe: Gestão de criaturas" isExecutable="false">
    <bpmn:startEvent id="Start_Cri" name="Abrir área de criaturas">
      <bpmn:outgoing>Flow_Cri_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Cri_Catalogo" name="Consultar catálogo público de criaturas">
      <bpmn:incoming>Flow_Cri_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Cri_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Cri_TemInicial" name="Já escolheu criatura inicial?">
      <bpmn:incoming>Flow_Cri_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Cri_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cri_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Cri_EscolherInicial" name="Escolher inicial (uma única vez)">
      <bpmn:incoming>Flow_Cri_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Cri_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Cri_Adquirir" name="Adquirir outra criatura">
      <bpmn:incoming>Flow_Cri_4</bpmn:incoming>
      <bpmn:incoming>Flow_Cri_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Cri_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Cri_Ativar" name="Definir criatura ativa (uma por usuário)">
      <bpmn:incoming>Flow_Cri_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Cri_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Cri_Evoluir" name="Solicitar evolução manual">
      <bpmn:incoming>Flow_Cri_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Cri_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Cri_FormaFinal" name="Já está na forma final?">
      <bpmn:incoming>Flow_Cri_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Cri_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cri_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cri_Final" name="Falha: forma final">
      <bpmn:incoming>Flow_Cri_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Cri_Nivel" name="Nível suficiente para próximo estágio?">
      <bpmn:incoming>Flow_Cri_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Cri_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cri_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cri_Nivel" name="Falha: nível insuficiente">
      <bpmn:incoming>Flow_Cri_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Cri_Evoluir1" name="Evoluir um estágio e registrar auditoria">
      <bpmn:incoming>Flow_Cri_11</bpmn:incoming>
      <bpmn:outgoing>Flow_Cri_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Cri_OK" name="Criatura evoluída">
      <bpmn:incoming>Flow_Cri_13</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Cri_1" sourceRef="Start_Cri" targetRef="Task_Cri_Catalogo" />
    <bpmn:sequenceFlow id="Flow_Cri_2" sourceRef="Task_Cri_Catalogo" targetRef="Gw_Cri_TemInicial" />
    <bpmn:sequenceFlow id="Flow_Cri_3" sourceRef="Gw_Cri_TemInicial" targetRef="Task_Cri_EscolherInicial" name="Não" />
    <bpmn:sequenceFlow id="Flow_Cri_4" sourceRef="Gw_Cri_TemInicial" targetRef="Task_Cri_Adquirir" name="Sim" />
    <bpmn:sequenceFlow id="Flow_Cri_5" sourceRef="Task_Cri_EscolherInicial" targetRef="Task_Cri_Adquirir" />
    <bpmn:sequenceFlow id="Flow_Cri_6" sourceRef="Task_Cri_Adquirir" targetRef="Task_Cri_Ativar" />
    <bpmn:sequenceFlow id="Flow_Cri_7" sourceRef="Task_Cri_Ativar" targetRef="Task_Cri_Evoluir" />
    <bpmn:sequenceFlow id="Flow_Cri_8" sourceRef="Task_Cri_Evoluir" targetRef="Gw_Cri_FormaFinal" />
    <bpmn:sequenceFlow id="Flow_Cri_9" sourceRef="Gw_Cri_FormaFinal" targetRef="End_Cri_Final" name="Sim" />
    <bpmn:sequenceFlow id="Flow_Cri_10" sourceRef="Gw_Cri_FormaFinal" targetRef="Gw_Cri_Nivel" name="Não" />
    <bpmn:sequenceFlow id="Flow_Cri_11" sourceRef="Gw_Cri_Nivel" targetRef="Task_Cri_Evoluir1" name="Sim" />
    <bpmn:sequenceFlow id="Flow_Cri_12" sourceRef="Gw_Cri_Nivel" targetRef="End_Cri_Nivel" name="Não" />
    <bpmn:sequenceFlow id="Flow_Cri_13" sourceRef="Task_Cri_Evoluir1" targetRef="End_Cri_OK" />
  </bpmn:process>

  <bpmn:process id="Proc_Detalhe_LGPD" name="Detalhe: Direitos LGPD (atividade, exportação, aceite, exclusão)" isExecutable="false">
    <bpmn:startEvent id="Start_LGPD" name="Abrir área de conta">
      <bpmn:outgoing>Flow_LGPD_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_LGPD_Atividade" name="Consultar atividade da conta">
      <bpmn:incoming>Flow_LGPD_1</bpmn:incoming>
      <bpmn:outgoing>Flow_LGPD_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_LGPD_Acao" name="Qual direito exercer?">
      <bpmn:incoming>Flow_LGPD_2</bpmn:incoming>
      <bpmn:outgoing>Flow_LGPD_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_LGPD_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_LGPD_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_LGPD_Exportar" name="Exportar dados pessoais em JSON">
      <bpmn:incoming>Flow_LGPD_3</bpmn:incoming>
      <bpmn:outgoing>Flow_LGPD_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_LGPD_Exportado" name="Exportação concluída">
      <bpmn:incoming>Flow_LGPD_6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_LGPD_Aceitar" name="Aceitar termos/privacidade pendentes">
      <bpmn:incoming>Flow_LGPD_4</bpmn:incoming>
      <bpmn:outgoing>Flow_LGPD_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_LGPD_Aceite" name="Novo aceite registrado">
      <bpmn:incoming>Flow_LGPD_7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_LGPD_SolicitarExc" name="Solicitar exclusão (e-mail + senha)">
      <bpmn:incoming>Flow_LGPD_5</bpmn:incoming>
      <bpmn:outgoing>Flow_LGPD_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_LGPD_EmailExc" name="Enviar link de confirmação de exclusão">
      <bpmn:incoming>Flow_LGPD_8</bpmn:incoming>
      <bpmn:outgoing>Flow_LGPD_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Evt_LGPD_Confirma" name="Receber token de confirmação">
      <bpmn:incoming>Flow_LGPD_9</bpmn:incoming>
      <bpmn:outgoing>Flow_LGPD_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_LGPD_Confirmacao" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_LGPD_Validar" name="Validar token e senha">
      <bpmn:incoming>Flow_LGPD_10</bpmn:incoming>
      <bpmn:outgoing>Flow_LGPD_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_LGPD_Valido" name="Token e senha válidos?">
      <bpmn:incoming>Flow_LGPD_11</bpmn:incoming>
      <bpmn:outgoing>Flow_LGPD_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_LGPD_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_LGPD_Invalido" name="Falha: token/senha inválidos">
      <bpmn:incoming>Flow_LGPD_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_LGPD_Anonimizar" name="Anonimizar conta e encerrar sessão">
      <bpmn:incoming>Flow_LGPD_12</bpmn:incoming>
      <bpmn:outgoing>Flow_LGPD_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_LGPD_Anonimizada" name="Conta anonimizada">
      <bpmn:incoming>Flow_LGPD_14</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_LGPD_1" sourceRef="Start_LGPD" targetRef="Task_LGPD_Atividade" />
    <bpmn:sequenceFlow id="Flow_LGPD_2" sourceRef="Task_LGPD_Atividade" targetRef="Gw_LGPD_Acao" />
    <bpmn:sequenceFlow id="Flow_LGPD_3" sourceRef="Gw_LGPD_Acao" targetRef="Task_LGPD_Exportar" name="Exportar" />
    <bpmn:sequenceFlow id="Flow_LGPD_4" sourceRef="Gw_LGPD_Acao" targetRef="Task_LGPD_Aceitar" name="Aceitar pendentes" />
    <bpmn:sequenceFlow id="Flow_LGPD_5" sourceRef="Gw_LGPD_Acao" targetRef="Task_LGPD_SolicitarExc" name="Excluir conta" />
    <bpmn:sequenceFlow id="Flow_LGPD_6" sourceRef="Task_LGPD_Exportar" targetRef="End_LGPD_Exportado" />
    <bpmn:sequenceFlow id="Flow_LGPD_7" sourceRef="Task_LGPD_Aceitar" targetRef="End_LGPD_Aceite" />
    <bpmn:sequenceFlow id="Flow_LGPD_8" sourceRef="Task_LGPD_SolicitarExc" targetRef="Task_LGPD_EmailExc" />
    <bpmn:sequenceFlow id="Flow_LGPD_9" sourceRef="Task_LGPD_EmailExc" targetRef="Evt_LGPD_Confirma" />
    <bpmn:sequenceFlow id="Flow_LGPD_10" sourceRef="Evt_LGPD_Confirma" targetRef="Task_LGPD_Validar" />
    <bpmn:sequenceFlow id="Flow_LGPD_11" sourceRef="Task_LGPD_Validar" targetRef="Gw_LGPD_Valido" />
    <bpmn:sequenceFlow id="Flow_LGPD_12" sourceRef="Gw_LGPD_Valido" targetRef="Task_LGPD_Anonimizar" name="Sim" />
    <bpmn:sequenceFlow id="Flow_LGPD_13" sourceRef="Gw_LGPD_Valido" targetRef="End_LGPD_Invalido" name="Não" />
    <bpmn:sequenceFlow id="Flow_LGPD_14" sourceRef="Task_LGPD_Anonimizar" targetRef="End_LGPD_Anonimizada" />
  </bpmn:process>

  <bpmn:process id="Proc_Detalhe_RBACAuditoria" name="Detalhe: Administração RBAC e auditoria" isExecutable="false">
