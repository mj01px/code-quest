# Copiar para .env.prod na VPS (fica fora do git) e preencher.
# Gerar segredos: python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# ==== Postgres (container db e DATABASE_URL do backend) ====
POSTGRES_DB=codequest
POSTGRES_USER=codequest
POSTGRES_PASSWORD=troque-por-uma-senha-longa

# ==== Django ====
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=False
# "backend" e o host que o Next usa por dentro da rede do Docker; 127.0.0.1 e
# o healthcheck do container. Somar o dominio (ou o IP publico, antes dele).
ALLOWED_HOSTS=seu-dominio.com.br,backend,127.0.0.1
ADMIN_URL=troque-isto/

FRONTEND_URL=https://seu-dominio.com.br
CSRF_TRUSTED_ORIGINS=https://seu-dominio.com.br
CORS_ALLOWED_ORIGINS=https://seu-dominio.com.br
# Cookies de login so por HTTPS. False apenas num teste por http, sem dominio.
AUTH_COOKIE_SECURE=True

# Primeiro deploy: 1 (carrega todo o conteudo). Depois: 0.
RODAR_SEEDS=1
# Modo demonstracao do PFC: deixa publicados SO os 9 exercicios da demo e
# despublica o resto das trilhas. Deixe 0 para o site com o conteudo completo.
SEED_DEMO_PFC=0

# ==== Admin inicial (comando criar_admin, roda na subida) ====
# Cria um unico admin, ja verificado e no nivel "Admin" do RBAC. Se o e-mail
# ja existir, nao faz nada. Nickname reservado (admin, codequest, equipe, staff
# ...) ou senha fraca derrubam a subida, com o motivo no log do backend.
# Depois do primeiro deploy, apagar ADMIN_PASSWORD daqui.
ADMIN_EMAIL=
ADMIN_NICKNAME=
ADMIN_PASSWORD=

# ==== E-mail (Brevo) ====
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CodeQuest <nao-responda@seu-dominio.com.br>

# ==== Judge0 (RapidAPI) ====
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_TOKEN=
JUDGE0_TIMEOUT=15
JUDGE0_LIMITE_DIARIO=50
JUDGE0_LIMITE_POR_USUARIO=10
