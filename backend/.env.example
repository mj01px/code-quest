# ==== Django ====
SECRET_KEY=$key_django
DEBUG=True
ALLOWED_HOSTS=$host_ip
ADMIN_URL=$admin_url

# ==== Banco (PostgreSQL) ====
DATABASE_URL=$url_postgres
# Tempo (segundos) que a conexao fica viva entre requisicoes.
# DB_CONN_MAX_AGE=60

# ==== Frontend e origens ====
FRONTEND_URL=$url_frontend
# Origens aceitas para CSRF e CORS. O dev server do Next roda na 3000.
CSRF_TRUSTED_ORIGINS=$url_CSRF
CORS_ALLOWED_ORIGINS=$url_CORS
# AUTH_COOKIE_SECURE=False

# ==== E-mail ====
EMAIL_HOST=$url_smtp
EMAIL_PORT=$port
EMAIL_HOST_USER=$email_host  
EMAIL_HOST_PASSWORD=$email_host_password
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=$default_email
# EMAIL_BACKEND=$backend_email

# ==== Prazos e limites ====
# Validade dos links de uso unico, em segundos.
VERIFICACAO_EMAIL_MAX_AGE=86400
REDEFINICAO_SENHA_MAX_AGE=1800
# Bloqueio de login apos tentativas repetidas.
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_SEGUNDOS=900
# Limite das rotas publicas de catalogo de trilhas.
THROTTLE_CATALOGO=60/min
# Limite da lista de exercicios concluidos do proprio aluno.
THROTTLE_EU_PROGRESSO=120/min
# Limite da rota de autoria que entrega a solucao de referencia.
THROTTLE_AUTORIA=30/min
# Limite das acoes do fluxo editorial (submeter, aprovar, devolver, publicar).
THROTTLE_EDITORIAL=30/min
# Proxies na frente do Django (o Next, pelo rewrite /api). O IP do aluno e o
# ultimo item do X-Forwarded-For. Exige Django so em 127.0.0.1 e Nginx
# sobrescrevendo o X-Forwarded-For com $remote_addr.
NUM_PROXIES=1

# ==== Criaturas ====
# De onde os sprites das criaturas sao servidos.
SPRITE_BASE_URL=$criaturas_url


# ==== JUDGE API ==
# Cota diaria do plano no RapidAPI. O disjuntor para novas chamadas em 90%.
JUDGE0_LIMITE_DIARIO=50
# Chamadas pagas por usuario por dia (acerto de cache nao conta).
JUDGE0_LIMITE_POR_USUARIO=10
JUDGE0_URL=$judge_api
JUDGE0_TOKEN=$judge_token
JUDGE0_TIMEOUT=15
