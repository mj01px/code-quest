# ==== Django ====
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_URL=admin/

# ==== Frontend e origens ====
# Base dos links enviados por e-mail. E o endereco do FRONTEND, nao o da API.
FRONTEND_URL=http://localhost:3000
# Origens aceitas para CSRF e CORS. O dev server do Next roda na 3000.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Cookies de auth apenas por https. Comentado usa o default: True fora de DEBUG.
# AUTH_COOKIE_SECURE=False

# ==== E-mail ====
# Sem EMAIL_HOST_USER, o backend cai no console: os links de verificacao e
# recuperacao aparecem no terminal do runserver e o dev nao precisa de SMTP.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=CodeQuest <nao-responda@seu-dominio.com>
# Forca um backend especifico. Comentado, escolhe sozinho pelo EMAIL_HOST_USER.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# ==== Prazos e limites ====
# Validade dos links de uso unico, em segundos.
VERIFICACAO_EMAIL_MAX_AGE=86400
REDEFINICAO_SENHA_MAX_AGE=1800
# Bloqueio de login apos tentativas repetidas.
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_SEGUNDOS=900
# Limite das rotas publicas de catalogo de trilhas.
THROTTLE_CATALOGO=60/min

# ==== Criaturas ====
# De onde os sprites das criaturas sao servidos.
SPRITE_BASE_URL=/criaturas/
